{
  "name": "nestdirect-automation-suite",
  "version": "1.0.0",
  "description": "Enterprise web API, Appium 3.x, and k6 load-testing suite for NestDirect",
  "main": "index.js",
  "scripts": {
    "test:selenium": "mocha selenium/specs/*.spec.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=selenium/reports,reportFilename=index",
    "test:appium": "mocha appium/specs/*.spec.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=appium/reports,reportFilename=index"
  },
  "dependencies": {
    "chai": "^4.3.10",
    "exceljs": "^4.4.0",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "appium": "3.6.0",
    "webdriverio": "9.30.1"
  }
}
