{
  "name": "nestdirect-automation-suite",
  "version": "1.0.0",
  "description": "Enterprise E2E Appium 2.x, Selenium WebDriver, and k6 Load Testing Suite for NestDirect",
  "main": "index.js",
  "scripts": {
    "test:appium": "mocha tests/appium/specs/*.spec.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=tests/appium/reports,reportFilename=index",
    "test:selenium": "mocha tests/selenium/specs/*.spec.js --timeout 60000 --reporter mochawesome --reporter-options reportDir=tests/selenium/reports,reportFilename=index",
    "test:k6": "k6 run load-tests/suite.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "appium": "^2.5.1",
    "appium-uiautomator2-driver": "^3.0.1",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "mocha": "^10.3.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.18.1",
    "webdriverio": "^8.32.4"
  }
}
