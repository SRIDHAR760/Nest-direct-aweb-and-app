rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isValidId(id) {
      return id is string
        && id.size() > 0
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_-]+$');
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['OWNER', 'SEEKER'];
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'favorites', 'onboardingCompleted', 'isKycVerified', 'displayName', 'photoURL'
        ]);
      allow delete: if false;
    }

    match /registered_users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['OWNER', 'SEEKER'];
      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role != 'ADMIN';
      allow delete: if false;
    }

    // PROPERTY MODERATION FLOW
    // Owner creates only PENDING/unpublished.
    // Admin alone can approve/reject/publish.
    match /properties/{propertyId} {
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (
          resource.data.status == 'APPROVED'
          && resource.data.verificationStatus == 'VERIFIED'
          && resource.data.isPublished == true
        );

      allow list: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (
          resource.data.status == 'APPROVED'
          && resource.data.verificationStatus == 'VERIFIED'
          && resource.data.isPublished == true
        );

      // Keep this rule intentionally simple so it exactly matches the
      // client-side setDoc() submission and does not reject optional fields.
      allow create: if isSignedIn()
        && isValidId(propertyId)
        && request.resource.data.id == propertyId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.verificationStatus == 'PENDING'
        && request.resource.data.isPublished == false
        && request.resource.data.ownerVerified == false;

      // Owners may edit their own pending/rejected listing details, but
      // moderation state can never be changed by the owner.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['PENDING', 'REJECTED']
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.status == resource.data.status
        && request.resource.data.verificationStatus == resource.data.verificationStatus
        && request.resource.data.isPublished == resource.data.isPublished
        && request.resource.data.ownerVerified == resource.data.ownerVerified
        && request.resource.data.reviewedBy == resource.data.reviewedBy
        && request.resource.data.reviewedAt == resource.data.reviewedAt
        && request.resource.data.rejectionReason == resource.data.rejectionReason;

      // Admin controls the moderation transition.
      allow update: if isAdmin()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.id == resource.data.id
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.status in ['PENDING', 'APPROVED', 'REJECTED', 'SUSPENDED']
        && request.resource.data.verificationStatus in ['PENDING', 'VERIFIED', 'REJECTED', 'SUSPENDED']
        && request.resource.data.isPublished is bool
        && request.resource.data.ownerVerified is bool;

      allow delete: if isAdmin()
        || (
          isSignedIn()
          && resource.data.ownerId == request.auth.uid
          && resource.data.status != 'APPROVED'
        );
    }

    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (
        resource.data.tenantEmail == request.auth.token.email
        || resource.data.ownerEmail == request.auth.token.email
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(inquiryId);
      allow update: if isSignedIn() && isValidId(inquiryId) && (
        isAdmin()
        || resource.data.ownerEmail == request.auth.token.email
        || resource.data.tenantEmail == request.auth.token.email
      );
      allow delete: if isSignedIn() && resource.data.tenantEmail == request.auth.token.email;
    }

    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        resource.data.tenantEmail == request.auth.token.email
        || resource.data.ownerEmail == request.auth.token.email
        || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(messageId);
      allow update: if isSignedIn() && isValidId(messageId) && (
        resource.data.tenantEmail == request.auth.token.email
        || resource.data.ownerEmail == request.auth.token.email
        || isAdmin()
      );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
