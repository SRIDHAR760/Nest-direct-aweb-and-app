rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid && incoming().role != 'ADMIN';
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['favorites','onboardingCompleted','isKycVerified','displayName','photoURL']);
      allow delete: if false;
    }

    match /registered_users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid && incoming().role != 'ADMIN';
      allow update: if isOwner(userId) && incoming().uid == request.auth.uid && incoming().role != 'ADMIN';
      allow delete: if false;
    }

    // ================================================================
    // PROPERTIES: owner creates PENDING; admin verifies; seekers see only published
    // ================================================================
    match /properties/{propertyId} {
      // Admin can inspect every property. Public/seekers can only inspect published ones.
      allow get: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (resource.data.status == 'APPROVED' && resource.data.verificationStatus == 'VERIFIED' && resource.data.isPublished == true);

      // Query rules are not filters. Public queries must explicitly constrain these fields.
      // Admin can query the complete collection.
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || (resource.data.status == 'APPROVED' && resource.data.verificationStatus == 'VERIFIED' && resource.data.isPublished == true);

      // Owner submission: the client can NEVER create an approved/published listing.
      allow create: if isSignedIn()
        && isValidId(propertyId)
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'PENDING'
        && incoming().verificationStatus == 'PENDING'
        && incoming().isPublished == false
        && incoming().ownerVerified == false
        && incoming().reviewedBy == null
        && incoming().reviewedAt == null
        && incoming().rejectionReason == null
        && incoming().id == propertyId
        && incoming().title is string
        && incoming().description is string
        && incoming().price is number
        && incoming().type is string
        && incoming().address is string
        && incoming().city is string
        && incoming().ownerName is string
        && incoming().createdAt is string;

      // Owner may edit normal details only while still pending/rejected. Moderation fields are immutable to owners.
      allow update: if isSignedIn()
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().status == existing().status
        && incoming().verificationStatus == existing().verificationStatus
        && incoming().isPublished == existing().isPublished
        && incoming().reviewedBy == existing().reviewedBy
        && incoming().reviewedAt == existing().reviewedAt
        && incoming().rejectionReason == existing().rejectionReason
        && incoming().ownerVerified == existing().ownerVerified;

      // Only an ADMIN can approve/reject/suspend/publish.
      allow update: if isAdmin()
        && incoming().ownerId == existing().ownerId
        && incoming().id == existing().id
        && incoming().status in ['PENDING','APPROVED','REJECTED','SUSPENDED']
        && incoming().verificationStatus in ['PENDING','VERIFIED','REJECTED','SUSPENDED']
        && incoming().isPublished is bool
        && incoming().reviewedBy == request.auth.uid;

      allow delete: if isAdmin() || (isSignedIn() && existing().ownerId == request.auth.uid && existing().status != 'APPROVED');
    }

    // ================================================================
    // Existing inquiry/chat functionality
    // ================================================================
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (
        resource.data.tenantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isSignedIn() && (isAdmin() ||
        (request.query.limit <= 50 && (
          request.query.where.tenantEmail == request.auth.token.email ||
          request.query.where.ownerEmail == request.auth.token.email
        )));
      allow create: if isSignedIn() && isValidId(inquiryId);
      allow update: if isSignedIn() && isValidId(inquiryId) &&
        (isAdmin() || resource.data.ownerEmail == request.auth.token.email || resource.data.tenantEmail == request.auth.token.email);
      allow delete: if isSignedIn() && resource.data.tenantEmail == request.auth.token.email;
    }

    match /chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && (
        resource.data.tenantEmail == request.auth.token.email ||
        resource.data.ownerEmail == request.auth.token.email ||
        isAdmin()
      );
      allow list: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && isValidId(messageId);
      allow update: if isSignedIn() && isValidId(messageId) && (
        resource.data.tenantEmail == request.auth.token.email || resource.data.ownerEmail == request.auth.token.email || isAdmin()
      );
      allow delete: if false;
    }

    // Everything not explicitly allowed above is denied.
    match /{document=**} { allow read, write: if false; }
  }
}
